# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=local
DEBUG=false
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL (in docker compose the host is "db")
DATABASE_URL=postgresql+psycopg://biletflow:biletflow@localhost:5432/biletflow

# Auth
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Admission QR signing secret
QR_SECRET=change-me-too

# Orders
RESERVATION_TTL_MINUTES=10

# Email — MailHog (in docker compose the host is "mail")
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=BiletFlow <no-reply@biletflow.kz>
EMAIL_BACKEND=smtp
API_BASE_URL=http://localhost:8000
# Address clients (web / mobile) use to reach the API; empty → taken from each request
PUBLIC_API_URL=

# Object storage — any S3-compatible service (SeaweedFS in docker compose, host "storage:8333")
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=biletflow
STORAGE_BACKEND=s3

# Payments (simulated), KZT minor units
ACTIVATION_FEE_MINOR=500000
